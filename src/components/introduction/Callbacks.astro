---

<div class="flex gap-2 mb-12 w-80 justify-start p-6">
  <div class="box green"></div>
</div>

<div class="flex gap-2 flex-wrap max-w-80 justify-center">
  <button
    id="play"
    class="bg-neutral-800 text-white font-bold py-2 px-4 rounded hover:bg-neutral-700 transition"
  >
    play()
  </button>
  <button
    id="pause"
    class="bg-neutral-800 text-white font-bold py-2 px-4 rounded hover:bg-neutral-700 transition"
  >
    pause()
  </button>
  <button
    id="resume"
    class="bg-neutral-800 text-white font-bold py-2 px-4 rounded hover:bg-neutral-700 transition"
  >
    resume()
  </button>
  <button
    id="reverse"
    class="bg-neutral-800 text-white font-bold py-2 px-4 rounded hover:bg-neutral-700 transition"
  >
    reverse()
  </button>
  <button
    id="restart"
    class="bg-neutral-800 text-white font-bold py-2 px-4 rounded hover:bg-neutral-700 transition"
  >
    restart()
  </button>
  <button
    id="faster"
    class="bg-neutral-800 text-white font-bold py-2 px-4 rounded hover:bg-neutral-700 transition"
  >
    faster()
  </button>

  <button
    id="slower"
    class="bg-neutral-800 text-white font-bold py-2 px-4 rounded hover:bg-neutral-700 transition"
  >
    slower()
  </button>
  <button
    id="normal"
    class="bg-neutral-800 text-white font-bold py-2 px-4 rounded hover:bg-neutral-700 transition"
  >
    normal()
  </button>
</div>

<style>
  .box {
    width: 50px;
    height: 50px;
    border-radius: 0.25rem;
    background-color: #3498db;
  }

  .green {
    background-color: #2ecc71;
  }
</style>

<script>
  import gsap from "gsap";

  const pauseButton = document.getElementById("pause") as HTMLButtonElement;
  const playButton = document.getElementById("play") as HTMLButtonElement;
  const resumeButton = document.getElementById("resume") as HTMLButtonElement;
  const reverseButton = document.getElementById("reverse") as HTMLButtonElement;
  const restartButton = document.getElementById("restart") as HTMLButtonElement;
  const fasterButton = document.getElementById("faster") as HTMLButtonElement;
  const slowerButton = document.getElementById("slower") as HTMLButtonElement;
  const normalButton = document.getElementById("normal") as HTMLButtonElement;

  const tl = gsap.timeline({ paused: true });

  tl.to(".box", {
    duration: 1,
    repeat: -1,
    yoyo: true,
    x: 200,
    rotation: 360,
    scale: 2,
    backgroundColor: "#e74c3c",
    ease: "power1.inOut",
    onStart: () => {
      console.log("Animation started");
    },

    onComplete: () => {
      console.log("Animation completed");
    },

    onReverseComplete: () => {
      console.log("Animation reversed");
    },

    onRepeat: () => {
      console.log("Animation repeated");
    },

    onUpdate: () => {
      console.log("Animation updated");
    },
  });

  playButton.addEventListener("click", () => {
    tl.play();
  });

  pauseButton.addEventListener("click", () => {
    tl.pause();
  });

  resumeButton.addEventListener("click", () => {
    tl.resume();
  });

  reverseButton.addEventListener("click", () => {
    tl.reverse();
  });

  restartButton.addEventListener("click", () => {
    tl.restart();
  });

  fasterButton.addEventListener("click", () => {
    tl.timeScale(2);
  });

  slowerButton.addEventListener("click", () => {
    tl.timeScale(0.5);
  });

  normalButton.addEventListener("click", () => {
    tl.timeScale(1);
  });
</script>

<div class="container">
  <div class="silhouette" id="Bulbasaur"><div class="cover"></div></div>
  <div class="card">
    <h1>Who's</h1>
    <div class="information" id="BulbasaurInfo">
      <h2 id="BulbasaurName">Bulbasaur</h2>
      <p>
        Bulbasaur can be seen napping in bright sunlight. There is a seed on its
        back. By soaking up the sun's rays, the seed grows progressively larger.
      </p>
      <p class="type">
        Type: <button id="grass">Grass</button>
        <button id="poison">Poison</button>
      </p>
    </div>
  </div>
</div>

<div class="container">
  <div class="silhouette" id="Charmander"><div class="cover"></div></div>
  <div class="card">
    <h1>That</h1>
    <div class="information" id="CharmanderInfo">
      <h2 id="CharmanderName">Charmander</h2>
      <p>
        The flame that burns at the tip of its tail is an indication of its
        emotions. The flame wavers when Charmander is enjoying itself. If the
        Pokémon becomes enraged, the flame burns fiercely.
      </p>
      <p class="type">Type: <button id="fire">Fire</button></p>
    </div>
  </div>
</div>

<div class="container">
  <div class="silhouette" id="Squirtle"><div class="cover"></div></div>
  <div class="card">
    <h1>Pokémon?</h1>
    <div class="information" id="SquirtleInfo">
      <h2 id="SquirtleName">Squirtle</h2>
      <p>
        Squirtle's shell is not merely used for protection. The shell's rounded
        shape and the grooves on its surface help minimize resistance in water,
        enabling this Pokémon to swim at high speeds.
      </p>
      <p class="type">Type: <button id="water">Water</button></p>
    </div>
  </div>
</div>

<div class="instructions">Hover over a card to find out!</div>

<script>
  import type { TimelineLite } from "gsap";
  import gsap from "gsap";

  gsap.set(".information", { yPercent: 100 });

  const containers = gsap.utils.toArray(".container") as HTMLElement[];

  containers.forEach((container) => {
    const info = container.querySelector(".information") as HTMLElement;
    const silhouette = container.querySelector(
      ".silhouette .cover"
    ) as HTMLElement;

    if (!info || !silhouette) {
      console.warn("Missing elements in container:", container);
      return;
    }

    const tl: TimelineLite = gsap.timeline({ paused: true });

    tl.to(info, { yPercent: 0 }).to(silhouette, { opacity: 0 }, 0);

    container.addEventListener("mouseenter", () => tl.timeScale(1).play());
    container.addEventListener("mouseleave", () => tl.timeScale(3).reverse());
  });
</script>

<style>
  .container {
    width: 20%;
    min-width: 200px;
    max-width: 250px;
    height: 450px;
    float: left;
    margin: 0 10px;
  }
  .silhouette {
    position: relative;
    width: 100px;
    height: 100px;
    background-size: cover;
    margin: auto;
  }
  .silhouette .cover {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
  }

  .type {
    text-align: justify;
  }

  .card {
    background-color: #f4f4f9;
    height: calc(100% - 150px);
    align-self: center;
    border-radius: 10px;
    text-align: center;
    padding-top: 40%;
    box-shadow: 0px 0px 12px -1px rgba(0, 0, 0, 0.2);
    margin: auto;
    overflow: hidden;
    position: relative;
  }

  h1 {
    font-family: "Bebas Neue", sans-serif;
    letter-spacing: 2px;
    font-size: 30pt;
    color: #333333;
  }

  #Bulbasaur {
    background-image: url(https://assets.pokemon.com/assets/cms2/img/pokedex/full/001.png);
  }
  #Bulbasaur .cover {
    background-image: url(https://assets.codepen.io/16327/001-silhouette.png);
  }

  #Charmander {
    background-image: url(https://assets.pokemon.com/assets/cms2/img/pokedex/full/004.png);
  }
  #Charmander .cover {
    background-image: url(https://assets.codepen.io/16327/004-silhouette.png);
  }

  #Squirtle {
    background-image: url(https://assets.pokemon.com/assets/cms2/img/pokedex/detail/007.png);
  }
  #Squirtle .cover {
    background-image: url(https://assets.codepen.io/16327/007-silhouette.png);
  }

  .information {
    background-color: #ffffff;
    height: 100%;
    border-radius: 10px;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    margin: auto;
    text-align: center;
  }

  #BulbasaurInfo {
    border-top: 10px solid #6ab04c;
    border-bottom: 10px solid #6ab04c;
  }

  #CharmanderInfo {
    border-top: 10px solid #eb4d4b;
    border-bottom: 10px solid #eb4d4b;
  }

  #SquirtleInfo {
    border-top: 10px solid #22a6b3;
    border-bottom: 10px solid #22a6b3;
  }

  h2 {
    text-align: center;
    padding-bottom: 10px;
    color: #2d3436;
  }

  #BulbasaurName {
    border-bottom: dashed 2px #6ab04c;
  }

  #CharmanderName {
    border-bottom: dashed 2px #eb4d4b;
  }

  #SquirtleName {
    border-bottom: dashed 2px #22a6b3;
  }

  p {
    padding-left: 10px;
    padding-right: 10px;
    font-family: "Raleway", sans-serif;
    font-size: 10pt;
    color: #636e72;
  }

  button {
    height: auto;
    border: none;
    color: white;
    border-radius: 10px;
    font-size: 10pt;
    cursor: pointer;
  }

  #grass {
    background-color: #6ab04c;
  }

  #poison {
    background-color: #be2edd;
  }

  #fire {
    background-color: #eb4d4b;
  }

  #water {
    background-color: #22a6b3;
  }

  .instructions {
    width: 100%;
    text-align: center;
    font-size: 20pt;
    color: #b2bec3;
  }
</style>
