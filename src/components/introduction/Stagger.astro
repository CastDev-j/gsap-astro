<style>
  .box,
  .box-2d {
    width: 50px;
    height: 50px;
    background-color: red;
  }
</style>

<script>
  import gsap from "gsap";

  gsap.to(".box", {
    stagger: {
      each: 0.1,
      from: "random",
      repeat: -1,
      yoyo: true,
    },
    duration: 0.7,
    ease: "power1.inOut",
    y: 100,
  });

  gsap.to(".box-2d", {
    stagger: {
      each: 0.3,
      from: "center",
      amount: 0.5,
      grid: "auto",
      repeat: -1,
      yoyo: true,
    },
    duration: 1,
    scale: 0.1,
    y: 50,
    ease: "power1.inOut",
  });
</script>
